# Research Consensus Council Frontend — Environment configuration
# Copy this file to .env before running the Vite app. See SETUP.md.
# Local stub API is usually on 8090; Docker Compose publishes the API on 8080.

# Live WebSocket deliberation endpoint
VITE_API_WSS_URL=ws://127.0.0.1:8090

# REST API for papers, upload, settings, HITL
VITE_API_REST_URL=http://127.0.0.1:8090
