# Research Consensus Council — Settings Configuration template
# Copy this file to .env and configure before startup to prevent validation crashes.
# Full setup: SETUP.md (local API often uses port 8090; Docker uses 8080).

# Primary LLM Provider: stub | ollama | openai
LLM_PROVIDER=stub

# Fallback LLM Provider (used if primary circuit trips): stub
FALLBACK_PROVIDER=stub

# Mandatory OpenAI API Key (provide dummy value if provider is stub/ollama)
OPENAI_API_KEY=dummy-openai-api-key-value

# Slack/Discord webhook URL for state-change notifications
# Local stub pairing with Vite: use 8090. Docker Compose: use 8080.
WEBHOOK_URL=http://127.0.0.1:8090/dummy-webhook

# Ollama local host URL (default handles container networking)
OLLAMA_HOST=http://host.docker.internal:11434

# SQLite Database Schema Storage path
DB_PATH=council.db

# Optional Chroma path (defaults under project / Docker data volume)
# CHROMA_DB_PATH=chroma_db

# Optional retrieval: chroma | jina | hybrid
# RETRIEVAL_BACKEND=hybrid
# JINA_API_KEY=
