# Research Consensus Council — Environment Template
# Copy this file to .env and configure as needed.

# Database Path (default: council.db)
RCC_DB=council.db

# LLM Provider selection: stub | ollama | openai
RCC_LLM_PROVIDER=stub

# Ollama Server Host URI (only required if RCC_LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# OpenAI API Key (only required if RCC_LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Webhook Alert integration URL (optional)
RCC_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

# Non-Interactive deliberation flow (default: false, set to true for headless/automated/CI runs)
RCC_NON_INTERACTIVE=false
